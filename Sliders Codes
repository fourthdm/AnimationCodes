import {
  Component,
  ElementRef,
  HostListener,
  ViewChild,
  AfterViewInit
} from '@angular/core';

interface Slide {
  title: string;
  subtitle: string;
  image: string;
}

@Component({
  selector: 'app-solar-slider',
  templateUrl: './solar-slider.component.html',
  styleUrls: ['./solar-slider.component.scss']
})
export class SolarSliderComponent implements AfterViewInit {
  @ViewChild('sliderSection') sliderSection!: ElementRef<HTMLElement>;

  activeIndex = 0;
  scrollProgress = 0;

  slides: Slide[] = [
    {
      title: 'Solar Energy Solutions',
      subtitle: 'Powering a cleaner and brighter future.',
      image: 'assets/slider/slide-1.jpg'
    },
    {
      title: 'Industrial Solar Projects',
      subtitle: 'Reliable renewable energy for large-scale operations.',
      image: 'assets/slider/slide-2.jpg'
    },
    {
      title: 'Sustainable Innovation',
      subtitle: 'Smart solar systems designed for every environment.',
      image: 'assets/slider/slide-3.jpg'
    }
  ];

  ngAfterViewInit(): void {
    setTimeout(() => this.updateSlider(), 100);
  }

  @HostListener('window:scroll')
  onScroll(): void {
    this.updateSlider();
  }

  @HostListener('window:resize')
  onResize(): void {
    this.updateSlider();
  }

  updateSlider(): void {
    if (!this.sliderSection) return;

    const section = this.sliderSection.nativeElement;
    const rect = section.getBoundingClientRect();
    const windowHeight = window.innerHeight;

    const totalScrollable = section.offsetHeight - windowHeight;
    const scrolled = Math.min(
      Math.max(-rect.top, 0),
      totalScrollable
    );

    const progress = totalScrollable > 0 ? scrolled / totalScrollable : 0;
    this.scrollProgress = progress;

    const index = Math.min(
      this.slides.length - 1,
      Math.floor(progress * this.slides.length)
    );

    this.activeIndex = index;
  }

  goToSlide(index: number): void {
    const section = this.sliderSection.nativeElement;
    const windowHeight = window.innerHeight;
    const totalScrollable = section.offsetHeight - windowHeight;
    const targetScroll =
      section.offsetTop + (totalScrollable / (this.slides.length - 1)) * index;

    window.scrollTo({
      top: targetScroll,
      behavior: 'smooth'
    });
  }
}


